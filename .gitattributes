# Mark generated protobuf/gRPC Swift files so GitHub collapses them in PRs
swift/WendyAgentCore/Sources/*/Proto/**/*.pb.swift    linguist-generated=true
swift/WendyAgentCore/Sources/*/Proto/**/*.grpc.swift  linguist-generated=true
Examples/*/Sources/*/Generated/*.pb.swift            linguist-generated=true
Examples/*/Sources/*/Generated/*.grpc.swift          linguist-generated=true

# ROS bridge protobuf/gRPC Python bindings only.
go/ros2/go2-bridge/go2_bridge/*_pb2.py       linguist-generated=true
go/ros2/go2-bridge/go2_bridge/*_pb2_grpc.py  linguist-generated=true

# Mark generated protobuf/gRPC Go files so GitHub collapses them in PRs.
# Security review uses its own fixed generated-root allowlist.
go/proto/gen/**                        linguist-generated=true
*.pb.go                                linguist-generated=true
*_grpc.pb.go                           linguist-generated=true

# The Wendy plugin launcher and its tests run under sh (Git Bash on Windows)
# and parse each other line by line, so they keep LF on every checkout.
plugins/wendy/scripts/* text eol=lf
scripts/pin-cli.sh text eol=lf
scripts/test/plugin-launcher/* text eol=lf

# Skill entrypoints are parsed and embedded byte-for-byte. Keep their YAML
# frontmatter delimiters intact on Windows, including packaging sources.
**/SKILL.md text eol=lf
