+// wendyPeerAddr translates only the dialing endpoint, never the authenticated
+// PairingInfo or certificate. VIPs are observer-local, so use this node's
+// discovery for the peer UUID instead of a private IP or another node's VIP.
+func (m *Manager) wendyPeerAddr(uuid, fallback string) string {
+	if m.browser != nil {
+		hosts, port, ok := m.browser.Resolve(uuid)
+		if ok {
+			for _, host := range hosts {
+				ip := net.ParseIP(host).To4()
+				if ip != nil && ip[0] == 10 && ip[1] == 99 {
+					return joinHostPort(host, port, m.port)
+				}
+			}
+		}
+	}
+	return fallback
+}
