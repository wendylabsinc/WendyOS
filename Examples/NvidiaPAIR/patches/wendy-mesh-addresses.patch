+func TestCandidatesWendyMeshProjection(t *testing.T) {
+	txt := []string{"ip=10.88.0.2", "ips=10.88.0.2,192.168.1.7"}
+	for _, vip := range []string{"10.99.0.2", "10.99.0.3"} {
+		got := Candidates(txt, []string{vip, "10.88.0.2"})
+		if len(got) != 1 || got[0] != vip {
+			t.Fatalf("projected peer %s: got %v", vip, got)
+		}
+	}
+}
