+func TestWendyPairingUsesObserverLocalEndpoint(t *testing.T) {
+	m := newTestManagerPort(t, 14321)
+	peer := "33333333-3333-3333-3333-333333333333"
+	m.browser = newBrowser()
+	m.browser.setRelay([]noderec.DirectoryNode{{
+		HostUUID: peer, Name: "wendy", IP: "10.99.0.2",
+		Services: map[noderec.ServiceKey]noderec.ServiceStatus{noderec.ServiceCluster: {Port: 14321}},
+	}})
+	pi := &PairingInfo{NodeUUID: peer, NodeID: "wendy", Addr: "10.81.76.50:14321"}
+	if got := m.wendyPeerAddr(peer, pi.Addr); got != "10.99.0.2:14321" {
+		t.Fatalf("pairing callback = %q", got)
+	}
+	m.recordMember(pi, stateMember, nil)
+	if pi.Addr != "10.81.76.50:14321" {
+		t.Fatal("authenticated PairingInfo was modified")
+	}
+	member, ok := m.memberByNodeID(peer)
+	if !ok || member.IPAddress != "10.99.0.2" {
+		t.Fatalf("member = %+v", member)
+	}
+	m.noteObservedPeerHost(peer, "10.81.76.49")
+	if got := m.observedPeerHost(peer); got != "10.99.0.2" {
+		t.Fatalf("ingress proxy mistaken for peer: %q", got)
+	}
+	// A stored address from another observer must not override local discovery.
+	member.IPAddress = "10.99.0.42"
+	got := m.resolvePeerAddrs(*member)
+	if len(got) != 1 || got[0] != "10.99.0.2:14321" {
+		t.Fatalf("peer endpoints = %v", got)
+	}
+	if got := m.wendyPeerAddr("unknown", pi.Addr); got != pi.Addr {
+		t.Fatalf("ordinary fallback changed: %q", got)
+	}
+}
