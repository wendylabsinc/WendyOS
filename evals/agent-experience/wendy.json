{
  "appId": "sh.wendy.evals.model-tool-report",
  "version": "1.0.0",
  "platform": "linux",
  "restartPolicy": "unless-stopped",
  "entitlements": [
    { "type": "gpu" },
    { "type": "admin" },
    { "type": "build" },
    { "type": "network", "mode": "host" },
    { "type": "persist", "name": "models", "path": "/models" },
    { "type": "persist", "name": "results", "path": "/results" },
    { "type": "persist", "name": "buildkit-cache", "path": "/var/lib/buildkit" }
  ]
}
