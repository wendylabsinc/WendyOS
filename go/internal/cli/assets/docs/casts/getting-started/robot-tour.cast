[8.447, "o", "\r\u001b[1;38;2;52;211;153mWhat would you like to build?\u001b[0m\u001b[K\r\n\u001b[38;5;240m  ↑/↓ navigate, enter select, q quit\u001b[0m\u001b[K\r\n\u001b[K\r\n\u001b[48;2;6;95;70m \u001b[0m\u001b[1;38;2;236;253;245;48;2;6;95;70mName                       \u001b[0m\u001b[48;2;6;95;70m \u001b[0m\u001b[48;2;6;95;70m \u001b[0m\u001b[1;38;2;236;253;245;48;2;6;95;70mDescription                                     \u001b[0m\u001b[48;2;6;95;70m \u001b[0m\u001b[K\r\n\u001b[1;38;2;209;250;229;48;2;6;78;59m Waypoint patrol              Follow a route once, then stop                   \u001b[0m\u001b[K\r\n Obstacle-aware roaming       Use lidar to stop and turn around obstacles      \u001b[K\r\n Your own driving controls    Customize a browser keyboard controller          \u001b[K\r\n Sensor dashboard             Explore lidar, position, and other sensor data   \u001b[K\r\n Back                         Return to your robot                             \u001b[K\r\n\u001b[K\r"]
