[6.185, "o", "\r\u001b[1;38;2;52;211;153mChoose your next step\u001b[0m\u001b[K\r\n\u001b[38;5;240m  ↑/↓ navigate, enter select, q quit\u001b[0m\u001b[K\r\n\u001b[K\r\n\u001b[48;2;6;95;70m \u001b[0m\u001b[1;38;2;236;253;245;48;2;6;95;70mName                  \u001b[0m\u001b[48;2;6;95;70m \u001b[0m\u001b[48;2;6;95;70m \u001b[0m\u001b[1;38;2;236;253;245;48;2;6;95;70mDescription                                     \u001b[0m\u001b[48;2;6;95;70m \u001b[0m\u001b[K\r\n\u001b[1;38;2;209;250;229;48;2;6;78;59m Build a robot app       Edit Python, deploy it here, and try your idea   \u001b[0m\u001b[K\r\n Change the walk         Try a straight line or turn the other way        \u001b[K\r\n Drive in the browser    Use the viewer's keyboard controls               \u001b[K\r\n Finish for now          Leave the simulator running or stop it           \u001b[K\r\n\u001b[K\r"]
