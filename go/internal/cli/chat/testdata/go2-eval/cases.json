            "tool": "robot_command",
            "args": {
              "distance_meters": 0.5,
              "action": "forward"
            }
          },
          {
            "text": "The command outcome is unverified."
          }
        ]
      },
      {
        "prompt": "Retry the same command",
        "script": [
          {
            "tool": "robot_command",
            "args": {
              "distance_meters": 0.5,
              "action": "forward"
            }
          },
          {
            "text": "The original outcome remains unverified."
          }
        ]
      }
    ],
    "expect": {
      "no_motion": true,
      "max_dispatches": 1,
      "min_polls": 1,
      "required_actions": [
        "forward"
      ],
      "allow_turn_error": true
    },
    "fault": "malformed_receipt"
  },
