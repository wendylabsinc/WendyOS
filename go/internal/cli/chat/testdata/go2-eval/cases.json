  {
    "id": "go_to_unaligned",
    "description": "A rejected preflight must localize and then complete the original navigation.",
    "initial": {
      "connected": true,
      "aligned": false,
      "visible": false,
      "clear_floor": true
    },
    "turns": [
      {
        "prompt": "Go to the saved destination Desk",
        "script": [
          {
            "tool": "robot_command",
            "args": {
              "destination": "Desk",
              "action": "go_to"
            }
          },
          {
            "tool": "robot_command",
            "args": {
              "action": "localize_active"
            }
          },
          {
            "tool": "robot_command",
            "args": {
              "destination": "Desk",
              "action": "go_to"
            }
          },
          {
            "text": "The robot reached Desk."
          }
        ]
      }
    ],
    "expect": {
      "aligned": true,
      "reached": "Desk",
      "max_dispatches": 2,
      "min_polls": 1,
      "required_actions": [
        "localize_active",
        "go_to"
      ],
      "required_tools": [
        "robot_status"
      ]
    }
  },
