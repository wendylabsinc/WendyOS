  {
    "id": "malformed_receipt",
    "description": "An uncertain command and a later retry never redispatch movement.",
    "initial": {
      "connected": true,
      "aligned": false,
      "visible": false,
      "clear_floor": true
    },
    "turns": [
      {
        "prompt": "Move the Go2 forward 0.5 meters",
