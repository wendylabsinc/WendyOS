      {
        "prompt": "Please have a look around for a blue chair using the Go2. You may move it to search.",
        "script": [
          {
            "tool": "robot_find_object",
            "args": {
              "query": "blue chair"
            }
          },
          {
            "tool": "robot_command",
            "args": {
              "action": "find_active",
              "query": "blue chair",
              "model": "simulated-vision"
            }
          },
          {
            "text": "The blue chair was found."
          }
        ]
      }
    ],
    "expect": {
      "found": true,
      "max_dispatches": 1,
      "min_polls": 1,
      "required_actions": [
        "find_active"
      ],
      "query_words": [
        "blue",
        "chair"
      ],
      "forbidden_actions": [
        "go_to_object"
      ]
    }
  },
