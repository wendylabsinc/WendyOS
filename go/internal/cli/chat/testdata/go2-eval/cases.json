[
  {
    "id": "find_miss",
    "description": "Plain find automatically searches after a current-view miss.",
    "initial": {
      "connected": true,
      "aligned": false,
      "visible": false,
      "clear_floor": true
    },
    "turns": [
      {
        "prompt": "Find the blue chair",
        "script": [
          {
            "text": "The blue chair was found. I have not approached it."
          }
        ]
      }
    ],
    "expect": {
      "found": true,
      "max_dispatches": 1,
      "min_polls": 1,
      "required_actions": [
        "find_active"
      ],
      "required_tools": [
        "robot_find_object"
      ],
      "forbidden_actions": [
        "go_to_object"
      ],
      "query_words": [
        "blue",
        "chair"
      ]
    }
  },
