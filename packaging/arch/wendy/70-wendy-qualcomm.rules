# Qualcomm SoCs in Emergency Download mode (05c6:9008), used by
# `wendy os install` to flash the Dragonwing IQ-8275 over EDL. Arch variant of
# packaging/linux/udev/70-wendy-qualcomm.rules: Arch has no plugdev group, and
# udev drops a whole rule line that names an unknown group, so access comes only
# from uaccess (the user logged in at the active local seat). Others run the
# flash with sudo.
#
# The match is vendor-wide because 9008 is the single generic EDL id Qualcomm
# assigns across SoCs; a device only exposes it while deliberately put in EDL.
# Installed by the AUR wendy package from the CLI release archive. Must stay
# identical to edlUdevRule without GROUP (a test asserts it).
SUBSYSTEM=="usb", ATTRS{idVendor}=="05c6", MODE="0660", TAG+="uaccess"
