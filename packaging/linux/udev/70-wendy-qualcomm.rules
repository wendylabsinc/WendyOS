# Qualcomm SoCs in Emergency Download mode (05c6:9008), used by
# `wendy os install` to flash the Dragonwing IQ-8275 over EDL. Grants access to
# plugdev members and, via uaccess, the physically logged-in user.
#
# The match is vendor-wide rather than per-PID because 9008 is the single
# generic EDL id Qualcomm assigns across SoCs. A device only exposes this
# interface while it is in EDL — a mode entered deliberately by a DIP switch or
# an explicit reboot — so the extra grant is bounded. On distros without a
# plugdev group (e.g. Fedora/RHEL) create it and add yourself, or run with sudo:
#   sudo groupadd plugdev && sudo usermod -aG plugdev $USER
# Must stay identical to edlUdevRule in
# go/internal/cli/commands/os_install_dragonwing.go (a test asserts it).
SUBSYSTEM=="usb", ATTRS{idVendor}=="05c6", MODE="0660", GROUP="plugdev", TAG+="uaccess"
