# Export a trusted commit with git archive --format=tar --output=/absolute/source.tar HEAD.
SOURCE_ARCHIVE=/srv/wendy-spare/source.tar
WORKER_CPUS=2
WORKER_MEMORY=4g
MIN_FREE_GIB=10
MAX_REPORTS=200
WORKER_INDEX=0
WORKER_COUNT=1
# The NVIDIA override adds a separate concurrent review worker.
# MODES=fuzz,mutation,race

# NVIDIA override only. Provision for the chosen checkpoint before starting.
MODEL_CACHE=/srv/wendy-spare/models
VLLM_IMAGE=vllm/vllm-openai:v0.30.0
MODEL_WEIGHTS=Qwen/Qwen3.8-Flash-Next-FP8
MODEL_NAME=Qwen/Qwen3.8-Flash-Next
GPU_ID=0
MODEL_TENSOR_PARALLEL=1
MODEL_GPU_MEMORY_FRACTION=0.80
MODEL_MEMORY=128g
MODEL_CPUS=4
